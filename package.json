{
	"name": "micongre-web",
	"description": "Plataforma de administración de congregación sobre Next.js, Cloudflare Workers y D1.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"prebuild": "node scripts/set-database-id.mjs",
		"build": "next build",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types",
		"preview": "opennextjs-cloudflare build && wrangler dev",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"check": "npm run typecheck && npm run build",
		"setup": "node scripts/setup-cloudflare.mjs",
		"setup:secrets": "node scripts/setup-cloudflare.mjs --secrets",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:create-admin": "node scripts/create-admin.mjs"
	},
	"dependencies": {
		"docx": "^9.8.1",
		"drizzle-orm": "0.38.4",
		"fflate": "^0.8.3",
		"html-to-image": "^1.11.13",
		"lucide-react": "0.469.0",
		"maplibre-gl": "^5.24.0",
		"next": "15.5.26",
		"qrcode": "^1.5.4",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@opennextjs/cloudflare": "1.20.6",
		"@types/node": "22.10.7",
		"@types/qrcode": "^1.5.6",
		"@types/react": "19.0.7",
		"@types/react-dom": "19.0.3",
		"autoprefixer": "10.4.20",
		"drizzle-kit": "0.30.2",
		"postcss": "8.5.1",
		"tailwindcss": "3.4.17",
		"typescript": "5.9.3",
		"wrangler": "4.136.1"
	}
}
